# Configuração do Firebase.
#
# Copie este arquivo para `.env.local` (que é ignorado pelo Git) e preencha com
# os dados do SEU projeto: console do Firebase → Configurações do projeto →
# Seus apps → Web.
#
# Estes valores NÃO são segredo: a config web do Firebase vai no bundle e é
# pública por design. Quem protege os dados são as regras de segurança do
# Firestore. O `.env.local` fica fora do Git por higiene, não por sigilo.
#
# A credencial que É segredo é a service account do script de importação em
# Python — essa nunca entra no repositório.
#
# Lembrete de deploy: como o .env é ignorado pelo Git, ele NÃO chega na Vercel.
# O Vite resolve estas variáveis em tempo de build, então elas precisam estar
# cadastradas em Settings → Environment Variables antes do primeiro build.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_APP_ID=

# Empresa a que este app pertence. Todo documento vive sob
# businesses/{VITE_BUSINESS_ID}/...
#
# Enquanto houver uma empresa e um usuário só, o valor vem daqui. Quando o
# multiusuário virar produto, ele passa a vir do custom claim `businessId` do
# token — o código já prefere o claim quando ele existe, então essa migração não
# mexe no app, só nas regras e no script que atribui o claim.
VITE_BUSINESS_ID=loja-principal

# Opcional: 'true' aponta o app para os emuladores locais
# (Auth em 9099, Firestore em 8080) em vez do Firebase de verdade.
VITE_USE_FIREBASE_EMULATORS=false
